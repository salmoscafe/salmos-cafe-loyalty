# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` a git.

# --- Frontend (público, seguro en el bundle) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# URL de la Edge Function `loyverse-customers`.
# Opcional: si se omite, el cliente real asume
# `${VITE_SUPABASE_URL}/functions/v1/loyverse-customers`.
VITE_LOYVERSE_CUSTOMERS_FUNCTION_URL=

# --- Edge Function (SOLO servidor, jamás con prefijo VITE_) ---
LOYVERSE_ACCESS_TOKEN=tu-token-de-loyverse-modo-leer-escribir