# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` a git.

# --- Frontend (público, seguro en el bundle) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# URL de la Edge Function `loyverse-customers`.
# Opcional: si se omite, el cliente real asume
# `${VITE_SUPABASE_URL}/functions/v1/loyverse-customers`.
VITE_LOYVERSE_CUSTOMERS_FUNCTION_URL=

# --- Edge Function (SOLO servidor, jamás con prefijo VITE_) ---
LOYVERSE_ACCESS_TOKEN=tu-token-de-loyverse-modo-leer-escribir

# Secreto compartido del scheduler para la Edge `loyverse-receipts-sync`.
# El invocador (cron externo) debe mandar el header `x-sync-secret` con
# este valor; la función lo compara. Definir también en el dashboard de
# Supabase al desplegar la función (nunca en el bundle).
SYNC_CRON_SECRET=

# --- Supabase Auth: SMTP custom (AUTH-2) ---
# Definidas en `.env` (gitignored) al descomentar [auth.email.smtp] en
# `supabase/config.toml`. Datos de proveedor y dominio = externos/pendientes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=
# SMTP_SENDER_NAME="Salmos Café"

# --- Supabase Auth: Google OAuth (AUTH-1) ---
# Definidas en `.env` (gitignored) al descomentar [auth.external.google] en
# `supabase/config.toml`. Credenciales desde Google Cloud Console (externas/pendientes).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=